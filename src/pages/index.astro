---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import EventRow from "../components/EventRow.astro";
import EmailForm from "../components/EmailForm.astro";
import SectionHead from "../components/SectionHead.astro";
import SeriesCard from "../components/SeriesCard.astro";
import SponsorName from "../components/SponsorName.astro";
import mikePhoto from "../assets/mike.jpg";
import { getUpcomingEvents, rsvpUrl } from "../lib/events";
import {
  dateParts,
  localDateKey,
  monthDay,
  timeFull,
} from "../lib/events/format";
import { getActiveSeries } from "../lib/series";
import { getEventSponsor, getThanksTo } from "../lib/sponsors";
import { eventJsonLd } from "../lib/seo";
import { MIKE_EMAIL } from "../lib/site";

const [upcoming, series, venues, thanksTo, photoEntries] = await Promise.all([
  getUpcomingEvents(),
  getActiveSeries(),
  getCollection("venues"),
  getThanksTo(),
  getCollection("photos"),
]);

const next = upcoming[0];
// The next 3-4 events after the hero's. Hidden when fewer than 2.
const later = upcoming.slice(1, 5);
const showUpcoming = later.length >= 2;
const foodBy = await Promise.all(
  later.map(
    async (e) =>
      (await getEventSponsor(localDateKey(e.start), e.series))?.data.name
  )
);
const providers = [
  ...new Set(later.map((e) => e.providerLabel).filter(Boolean)),
];

const photos = photoEntries
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const heroMeta = next
  ? [timeFull(next.start), next.venueName ?? next.location, next.neighborhood]
      .filter(Boolean)
      .join(" · ")
  : "";
const when = next && dateParts(next.start);
const jsonLd = upcoming
  .slice(0, 5)
  .map((e) => eventJsonLd(e, "https://syracuse.io/"));
---

<BaseLayout
  title="syracuse.io · Developer meetups in Syracuse, NY"
  description="A free, volunteer-run community for people who care about software and technology in and around Syracuse. Monthly in-person meetups since April 2014, a local Slack, and one email a month."
  jsonLd={jsonLd}
>
  <section slot="hero" id="rsvp" class="wrap pb-16 pt-12">
    {
      next && when && (
        <>
          <div class="eyebrow text-muted-on-ink">
            Next up · {next.seriesName ?? "Community event"}
          </div>
          <div class="mt-3.5 flex flex-wrap items-end justify-between gap-x-12 gap-y-8">
            <div class="flex-[999_1_460px]">
              <div class="text-[clamp(64px,11vw,132px)] font-extrabold uppercase tabular-nums leading-[0.9] tracking-[-0.03em]">
                <span class="text-plow">{when.weekday}</span> {when.month}{" "}
                {when.day}
              </div>
              <div class="mt-[18px] font-mono text-[15px] text-muted-on-ink">
                {heroMeta}
              </div>
            </div>
            <div class="flex max-w-[320px] flex-[1_1_260px] flex-col gap-3">
              <a
                href={rsvpUrl(next)}
                data-track="rsvp"
                data-series={next.series ?? "community"}
                data-provider={next.provider}
                class="btn btn-primary min-h-[48px] px-5 py-3.5 text-[15px]"
              >
                RSVP for {monthDay(next.start)} →
              </a>
              {showUpcoming && (
                <a href="#upcoming" class="btn btn-ghost">
                  all upcoming
                </a>
              )}
            </div>
          </div>
        </>
      )
    }
    <h1
      class:list={[
        "max-w-[22ch] text-[clamp(26px,3.4vw,38px)] font-extrabold leading-[1.12] tracking-[-0.01em]",
        next && "mt-12 border-t border-[#3a423e] pt-6",
      ]}
    >
      Syracuse's developer community. Every month since April 2014.
    </h1>
  </section>

  <section class="wrap pb-4 pt-14">
    <p class="max-w-[40rem] text-xl leading-normal">
      A free, volunteer-run community for people who care about software and
      technology in and around Syracuse: students, career-switchers, hobbyists,
      and people who've been shipping for decades. We meet in person every
      month, talk in a local Slack in between, and send one email a month.
    </p>
  </section>

  {
    showUpcoming && (
      <section id="upcoming" class="wrap pb-14 pt-12">
        <SectionHead
          title="Upcoming"
          aside={providers.length ? `via ${providers.join(", ")}` : undefined}
        />
        {later.map((event, i) => (
          <EventRow event={event} foodBy={foodBy[i]} />
        ))}
      </section>
    )
  }

  {
    series.length > 0 && (
      <section id="series" class="wrap pb-16 pt-2">
        <h2 class="section-title mb-[18px]">The series</h2>
        <div class="grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))]">
          {series.map((s) => (
            <SeriesCard
              series={s}
              venueName={
                venues.find((v) => v.id === s.data.venue.id)?.data.name
              }
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="bg-steel text-salt">
    <div class="wrap pb-16 pt-14">
      <h2 class="section-title mb-8">Three ways in</h2>
      <div
        class="grid gap-9 [grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr))]"
      >
        <div>
          <div class="font-mono text-xs tracking-[0.14em] text-[#c9d6de]">
            01
          </div>
          <h3 class="mb-1.5 mt-1.5 text-[21px] font-extrabold">
            Come to a meetup
          </h3>
          <p class="mb-[18px] text-base text-[#dce4e8]">
            Show up, say hi, bring a laptop or don't.
          </p>
          {
            next ? (
              <a
                href={rsvpUrl(next)}
                data-track="rsvp"
                data-series={next.series ?? "community"}
                data-provider={next.provider}
                class="btn btn-light"
              >
                RSVP
              </a>
            ) : (
              <a href="#series" class="btn btn-light">
                see the meetups
              </a>
            )
          }
        </div>
        <div>
          <div class="font-mono text-xs tracking-[0.14em] text-[#c9d6de]">
            02
          </div>
          <h3 class="mb-1.5 mt-1.5 text-[21px] font-extrabold">
            Join the Slack
          </h3>
          <p class="mb-[18px] text-base text-[#dce4e8]">
            Ask questions, find people, see local jobs.
          </p>
          <a href="/slack" data-track="slack" class="btn btn-outline-light"
            >get an invite</a
          >
        </div>
        <EmailForm />
      </div>
    </div>
  </section>

  {
    photos.length > 0 && (
      <section class="wrap py-16">
        <div class="grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr))]">
          {photos.map((p) => (
            <figure class="m-0">
              <Image
                src={p.data.src}
                alt={p.data.alt}
                width={480}
                height={320}
                class="aspect-[3/2] w-full rounded-[3px] object-cover"
              />
              <figcaption class="mt-2 font-mono text-xs text-muted">
                {p.data.caption}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <section id="about" class="wrap pb-14 pt-16">
    <div class="card flex flex-wrap items-center gap-6 p-7">
      <Image
        src={mikePhoto}
        alt="Mike, who organizes the meetups"
        width={208}
        height={208}
        class="h-[104px] w-[104px] flex-none rounded-[3px] object-cover"
      />
      <div class="max-w-[44rem] flex-[1_1_320px]">
        <h2 class="mb-1.5 text-[22px] font-extrabold">
          Who can I reach out to?
        </h2>
        <p>
          Hi, I'm Mike. I organize these meetups and keep the lights on through{
            " "
          }
          <button
            type="button"
            popovertarget="codes-pop"
            class="cursor-pointer border-0 border-b-2 border-dotted border-brick bg-transparent p-0 font-[inherit] font-bold text-brick"
            >CODES</button
          ><span
            id="codes-pop"
            popover
            class="m-auto max-w-[300px] rounded bg-ink px-[18px] py-4 text-[15px] leading-[1.45] text-salt shadow-[4px_4px_0_var(--steel)]"
          >
            <span
              class="mb-1.5 block font-mono text-[11px] uppercase tracking-[0.14em] text-plow"
              >501(c)(3) nonprofit</span
            >CODES is the nonprofit dedicated to growing and sustaining the
            Syracuse tech community.<a
              href="/codes"
              class="mt-2.5 block font-mono text-[13px] font-bold text-salt hover:text-salt hover:underline"
              >see more at /codes →</a
            >
          </span>. If you're new, nervous, or have a question that feels too
          small for Slack, email me at{" "}
          <a href={`mailto:${MIKE_EMAIL}`} class="font-mono text-[15px]"
            >{MIKE_EMAIL}</a
          >. I answer.
        </p>
      </div>
    </div>
  </section>

  {
    thanksTo.length > 0 && (
      <section id="support" class="wrap pb-[72px]">
        <div class="border-t-2 border-ink pt-[18px]">
          <div class="eyebrow text-muted">Made possible by</div>
          <div class="mt-[18px] flex flex-wrap items-center gap-x-12 gap-y-4">
            {thanksTo.map((s) => (
              <SponsorName sponsor={s} />
            ))}
            <a href="/codes" class="ml-auto font-mono text-sm font-bold">
              support syracuse.io →
            </a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
