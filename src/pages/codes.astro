---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import { CODES_EMAIL } from "../lib/site";

export const prerender = true;

const board = [
  { name: "Mike Vormwald", linkedin: "mike.vormwald" },
  { name: "Annalena Davis", linkedin: null },
  { name: "Ed Forth", linkedin: null },
];

const tiers = [
  {
    name: "Sponsor an event",
    price: "$250",
    unit: "per event",
    blurb:
      "Covers pizza, drinks, and space for one meetup. Your logo on the event listing and a thank-you from the host.",
  },
  {
    name: "Sponsor the year",
    price: "$1,500",
    unit: "per year",
    blurb:
      "Keeps the lights on across the calendar. Enhanced company card in the directory, logo placement sitewide, and our gratitude at every event.",
  },
  {
    name: "Host in kind",
    price: "space",
    unit: "as available",
    blurb:
      "Got a conference room, a training space, or a big table? Hosting an event is worth as much as writing a check.",
  },
];
---

<BaseLayout
  content={{
    title: "CODES — the nonprofit behind syracuse.io",
    description:
      "The Coalition of Digital Engagements in Syracuse: a small 501(c)(3) serving the Syracuse tech community through education, mentoring, and economic opportunity.",
  }}
  editPath="src/pages/codes.astro"
>
  <div class="wrap max-w-[720px]">
    <div class="pt-10">
      <p class="eyebrow">Coalition of Digital Engagements in Syracuse</p>
      <h1
        class="mt-2 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl"
      >
        CODES
      </h1>
      <p class="mt-3 text-[15px]">
        CODES exists to keep Syracuse's tech community gathering. We organize
        events through <a
          class="text-brick hover:underline"
          href="https://www.meetup.com/syracuse-software-development-meetup/events/"
          >meetup.com</a
        >, paying for the venue, food, and drinks at monthly meetups like Open
        Hack, and we maintain <a href="/" class="text-brick hover:underline"
          >syracuse.io</a
        > in the open as the front door to the local tech scene. It's a small 501(c)(3)
        nonprofit: a few volunteers, a bank account for pizza money, and this website.
        That's the honest scale, and it's enough.
      </p>
    </div>

    <section class="pt-10">
      <SectionHead title="THE BOARD" />
      {/* Hairline borders, not Chip's — these aren't clickable. */}
      <div class="flex flex-wrap gap-2 pt-4">
        {
          board.map((member) =>
            member.linkedin ? (
              <a
                href={`https://www.linkedin.com/in/${member.linkedin}`}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-[3px] border border-line bg-card px-3 py-1.5 font-mono text-xs transition-colors hover:border-brick hover:text-brick"
              >
                {member.name}
              </a>
            ) : (
              <span class="rounded-[3px] border border-line bg-card px-3 py-1.5 font-mono text-xs">
                {member.name}
              </span>
            )
          )
        }
      </div>
    </section>

    <section class="pt-10">
      <SectionHead title="SPONSOR" />
      <p class="pt-4 text-[15px]">
        Sponsorship buys the pizza — nothing more, nothing less. No talent
        pipelines, no attendee lists, no stage time for sales decks. Here's what
        it costs and what you get:
      </p>
      <div class="grid gap-3 pt-4 sm:grid-cols-3">
        {
          tiers.map((tier) => (
            <div class="card flex flex-col gap-1.5 p-3.5">
              <span class="font-mono text-[22px] font-bold text-brick">
                {tier.price}
              </span>
              <span class="font-mono text-[11px] uppercase tracking-wider opacity-60">
                {tier.unit}
              </span>
              <span class="text-[15px] font-extrabold">{tier.name}</span>
              <span class="text-[13px] leading-snug">{tier.blurb}</span>
            </div>
          ))
        }
      </div>
      <p class="pt-5">
        <a
          href={`mailto:${CODES_EMAIL}?subject=${encodeURIComponent("Sponsoring the Syracuse tech community")}`}
          class="btn btn-primary">Sponsor or donate →</a
        >
      </p>
    </section>

    <section class="pb-4 pt-10">
      <SectionHead title="THE FINE PRINT" />
      <div class="space-y-3 pt-4 text-sm">
        <p>
          CODES (Coalition of Digital Engagements in Syracuse) is a registered
          501(c)(3) nonprofit organization, <code>EIN 85-2136324</code>.
          Donations are tax-deductible to the extent allowed by law. If your
          employer matches donations through Benevity or a similar platform,
          that EIN is what they'll ask for. Questions, receipts, or anything
          else: <a
            href={`mailto:${CODES_EMAIL}`}
            class="text-brick hover:underline">{CODES_EMAIL}</a
          >.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
