---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import { getNextEvent, rsvpUrl } from "../lib/events";
import { cleanPath } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Path-only canonical, defaults to the current path. */
  canonical?: string;
  /** schema.org objects emitted as JSON-LD. */
  jsonLd?: object[];
}
const { title, description, canonical, jsonLd = [] } = Astro.props;

// The nav RSVP button goes to the next event, or to the email signup when
// nothing is scheduled.
const next = await getNextEvent();
const rsvp = {
  href: next ? rsvpUrl(next) : "/#email",
  series: next?.series ?? "community",
  provider: next?.provider,
};
const canonicalUrl = new URL(
  canonical ?? cleanPath(Astro.url.pathname),
  Astro.site
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="syracuse.io" />
    {
      jsonLd.map((data) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
        />
      ))
    }
  </head>
  <body>
    <div class="bg-ink text-salt">
      <Header rsvp={rsvp} />
      <slot name="hero" />
    </div>
    <main>
      <slot />
    </main>
    <Footer rsvp={rsvp} />
    <Analytics />
  </body>
</html>
