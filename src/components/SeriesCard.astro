---
import type { Series } from "../lib/series";

interface Props {
  series: Series;
  venueName?: string;
}
const { series, venueName } = Astro.props;
const { data } = series;
---

<a href={`/${series.id}`} class="card p-6">
  <div class="eyebrow tracking-[0.12em] text-steel">{data.rhythm}</div>
  <div class="mt-2 text-3xl font-extrabold tracking-[-0.01em]">{data.name}</div>
  <p class="mb-4 mt-2.5">{data.summary}</p>
  <div class="flex justify-between font-mono text-[13px]">
    <span class="text-muted">{venueName && `at ${venueName}`}</span>
    <span class="font-bold text-brick">details →</span>
  </div>
</a>
