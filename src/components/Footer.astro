---
import Tbd from "./Tbd.astro";
import { CONTACT_EMAIL } from "../lib/site";

interface Props {
  rsvp: { href: string; series: string; provider?: string };
}
const { rsvp } = Astro.props;
---

<footer class="bg-ink text-muted-on-ink">
  <div
    class="wrap flex flex-wrap justify-between gap-x-8 gap-y-3.5 pb-10 pt-7 font-mono text-[13px]"
  >
    <div class="flex flex-wrap gap-[18px]">
      <a
        href={rsvp.href}
        class="text-salt hover:text-salt"
        data-track="rsvp"
        data-series={rsvp.series}
        data-provider={rsvp.provider}>rsvp</a
      >
      <a href="/slack" class="text-salt hover:text-salt" data-track="slack"
        >slack</a
      >
      <a href="/#email" class="text-salt hover:text-salt">monthly email</a>
    </div>
    <div>
      run by CODES, a 501(c)(3) nonprofit ·{" "}
      <a
        href="/codes"
        class="text-salt underline underline-offset-2 hover:text-salt">about</a
      >{" "}·{" "}
      <a
        href="/sponsor"
        class="text-salt underline underline-offset-2 hover:text-salt"
        >sponsor</a
      >{" "}·{" "}
      <a
        href="/code-of-conduct"
        class="text-salt underline underline-offset-2 hover:text-salt"
        >code of conduct</a
      >{" "}·{" "}
      <a
        href="/privacy"
        class="text-salt underline underline-offset-2 hover:text-salt"
        >privacy</a
      >
    </div>
    <div class="basis-full">
      contact:{" "}
      {
        CONTACT_EMAIL.includes("TBD(mike)") ? (
          <Tbd label="general contact email" />
        ) : (
          <a href={`mailto:${CONTACT_EMAIL}`} class="text-salt hover:text-salt">
            {CONTACT_EMAIL}
          </a>
        )
      }
    </div>
  </div>
</footer>
